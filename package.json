  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "chromedriver": "^158.0.1",
    "cross-env": "^10.1.0",
    "docx": "^9.16.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "selenium-webdriver": "^4.51.0",
    "supertest": "^7.3.2"
  }
