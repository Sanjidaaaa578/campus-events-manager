{
  "name": "campus-events-manager",
  "version": "1.0.0",
  "description": "Campus Events Manager web application for event browsing, registration, and reporting.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --testPathIgnorePatterns=tests/e2e",
    "test:unit": "cross-env NODE_ENV=test jest --runInBand --testPathIgnorePatterns=tests/e2e",
    "test:e2e": "cross-env NODE_ENV=test jest tests/e2e --runInBand",
    "test:all": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --testPathIgnorePatterns=tests/e2e --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanjidaaaa578/campus-events-manager.git"
  },
